{
  "name": "pth-scripts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-only utility scripts for PTH maintenance",
  "scripts": {
    "populate-images": "node populate-images.js",
    "populate-images:apply": "node populate-images.js --apply",
    "prerender-beaches": "node prerender-top-beaches.js --dry-run",
    "prerender-beaches:apply": "node prerender-top-beaches.js",
    "prerender-beaches:en": "node prerender-top-beaches.js --lang en",
    "prerender-beaches:en:dry": "node prerender-top-beaches.js --lang en --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.59.1",
    "sharp": "^0.33.5"
  }
}
